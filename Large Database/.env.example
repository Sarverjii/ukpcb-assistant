# Copy this file to ".env" in this same folder and fill in real values.
# ".env" itself is git-ignored (see the main project's .gitignore) — only
# this template, with no real credentials in it, is ever committed.

# The account this script logs in as. It must have "can upload documents"
# permission on its role (any admin account qualifies).
UKPCB_EMAIL=admin@ukpcb.gov.in
UKPCB_PASSWORD=

# Point this at the real deployment once it exists; defaults to local dev.
UKPCB_BASE_URL=http://localhost:3000

# Leave unset (the default) and every document this script uploads gets
# every clearance level and every department checked, fetched fresh from
# the server each run — see README.md's "What 'clearance to everyone'
# actually means here" section. Only set this if you want new uploads
# restricted to a specific role and everyone more senior than it, instead
# of literally everyone (must be a real role's hierarchyRank).
# CLEARANCE_LEVEL=

# How often (ms) to check on a document that's still being processed, and
# how long to wait before giving up on one run and leaving it for the
# next. Only worth raising POLL_TIMEOUT_MS if you're uploading unusually
# large scanned/OCR documents that legitimately take longer than 10 minutes.
# POLL_INTERVAL_MS=2000
# POLL_TIMEOUT_MS=600000

# How many files to upload/process at once. Overlapping several files'
# server-side waits (OCR passes, the embedding call) is the single biggest
# lever on total run time for a folder of many files — but every
# concurrent file is its own stream of real calls to whichever AI provider
# is active, so a higher number burns through a free-tier rate/quota limit
# that much faster. 3 is a conservative default; raise it if you're on a
# paid tier or lower it if you're hitting rate limits.
# CONCURRENCY=3

# Retries for a single status-check request before giving up on it for
# this run (the next run picks up checking the same document instead of
# re-uploading it) — guards against an occasional dropped/timed-out
# request to the status endpoint, which is unrelated to whether the
# document itself is actually fine.
# STATUS_FETCH_RETRIES=4
# STATUS_FETCH_RETRY_BASE_MS=2000
