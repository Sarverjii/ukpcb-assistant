# Postgres (see docker-compose.yml for local dev defaults)
DATABASE_URL="postgresql://ukpcb:ukpcb@localhost:5434/ukpcb"
DATABASE_URL_TEST="postgresql://ukpcb:ukpcb@localhost:5434/ukpcb_test"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""

# LLM/embedding provider selection is NOT an env var — it's entirely
# DB-driven via Admin -> AI Models once the app is running (no env-var
# fallback by design; see lib/llm/index.ts and lib/embeddings/index.ts).
# Log in as an admin and configure a real provider + API key there before
# chat or document upload will work at all.
#
# GEMINI_API_KEY below is the one exception, and only for the test suite:
# tests/setup.ts reads it directly (never the app itself) to auto-provision
# a working DB-activated provider so `npm test` runs standalone, without
# needing to drive the admin UI first. Leave it unset to skip the tests
# that need a real model call (the DB-layer security tests still run
# regardless — see tests/authz.test.ts).
# GEMINI_API_KEY=""

EMBEDDING_DIMENSIONS="768"

# Encrypts every API key an admin saves through Admin -> AI Models (see
# lib/ai/crypto.ts) — must decode to exactly 32 bytes. Required before
# anyone can save a credential there (not required just to run the app).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_CREDENTIALS_ENCRYPTION_KEY=""

# Document storage — Vercel serverless functions don't have a persistent,
# shared filesystem, so "local" doesn't reliably work there — use
# "vercel-blob" instead. Create a Blob store in the Vercel dashboard and
# connect it to the project — this provisions BLOB_STORE_ID automatically,
# but NOT BLOB_READ_WRITE_TOKEN (confirmed directly: it's genuinely absent
# from process.env after connecting a store this way). Get that token from
# the Blob store's own settings/quickstart page and add it as an env var
# yourself; the client-direct-upload flow this app uses for large files
# (app/api/documents/blob-upload-token) hard-requires it, with no fallback.
# "local" is fine for local dev or a traditional persistent server host.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage/documents"
UPLOAD_MAX_MB="100"
# BLOB_READ_WRITE_TOKEN=""
