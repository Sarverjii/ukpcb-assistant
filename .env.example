# Postgres (see docker-compose.yml for local dev defaults)
DATABASE_URL="postgresql://evon:evon@localhost:5433/ask_evon"
DATABASE_URL_TEST="postgresql://evon:evon@localhost:5433/ask_evon_test"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""

# Chat LLM provider — "gemini" uses Google's free API tier (get a key at
# https://aistudio.google.com/apikey — no card required, but NEVER attach
# billing to that Google Cloud project or the free tier disappears). Unlike
# "ollama" (also free, but needs a local model server — see below), this is
# a hosted API call, so it works the same in local dev and when deployed to
# a free hosting tier with no spare RAM for local inference.
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
# gemini-flash-latest is the stronger ("thinking") free-tier model; its
# capacity has measurably been unavailable for stretches at a time, so
# GEMINI_FALLBACK_MODEL is tried automatically on a persistent 503 instead
# of failing the request. Set GEMINI_MODEL="gemini-flash-lite-latest" and
# drop the fallback line if you'd rather just use the reliable model always.
GEMINI_MODEL="gemini-flash-latest"
GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"

# Alternative free option — a local model via https://ollama.com, no API
# key/signup, but won't run on typical free web-hosting tiers (needs several
# GB RAM). Set LLM_PROVIDER="ollama" and run `ollama pull llama3.1:8b` first.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# Paid option — Claude Sonnet 5. Set LLM_PROVIDER="anthropic" + a real key.
# ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Embeddings provider — "gemini" (default) is a hosted API call, reusing
# GEMINI_API_KEY above, with zero in-process memory footprint — the
# recommended choice for any real deployment. "local" runs a free,
# in-process model instead (no API key, but can exhaust RAM on a
# constrained host if you deploy with it — good for local dev only, or a
# host with real headroom): set EMBEDDING_PROVIDER="local",
# EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2", EMBEDDING_DIMENSIONS="384".
# Switching between providers needs a schema migration + re-embedding
# existing chunks — the two aren't interchangeable in the same column.
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS="768"
# OPENAI_API_KEY=""

# Optional: only needed once an admin actually saves a provider credential
# through Admin -> AI Models (see lib/ai/crypto.ts) — encrypts it at rest.
# Must decode to exactly 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AI_CREDENTIALS_ENCRYPTION_KEY=""

# Document storage — Vercel serverless functions don't have a persistent,
# shared filesystem, so "local" doesn't reliably work there — use
# "vercel-blob" instead. Create a Blob store in the Vercel dashboard and
# connect it to the project — this provisions BLOB_STORE_ID automatically,
# but NOT BLOB_READ_WRITE_TOKEN (confirmed directly: it's genuinely absent
# from process.env after connecting a store this way). Get that token from
# the Blob store's own settings/quickstart page and add it as an env var
# yourself; the client-direct-upload flow this app uses for large files
# (app/api/documents/blob-upload-token) hard-requires it, with no fallback.
# "local" is fine for local dev or a traditional persistent server host.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage/documents"
UPLOAD_MAX_MB="100"
# BLOB_READ_WRITE_TOKEN=""
