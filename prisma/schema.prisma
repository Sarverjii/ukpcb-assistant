// UKPCB Assistant — database schema
//
// Security note: `DocumentChunk.clearanceRank` is deliberately denormalized
// from `Document.clearanceLevel` at write time. Every retrieval query filters
// on this single column so authorization never depends on a join being
// present or correct — see lib/db/queries/chunks.ts.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL is no longer set here — it lives in
// prisma7.config.ts (CLI/migrations) and is passed explicitly to
// PrismaClient in lib/db/prisma.ts (app runtime). See both files' comments.
datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) required models -------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Organizational hierarchy -------------------------------------------

// Roles are DATA, not code. `hierarchyRank` is the single number the whole
// authorization system compares against — higher rank sees more. New roles
// (e.g. "Director") are inserts, never a code change.
model Role {
  id                       String   @id @default(cuid())
  name                     String   @unique
  hierarchyRank            Int      @unique
  canUploadDocuments       Boolean  @default(false)
  // Gates the admin dashboard (employee management, document management
  // actions, audit log viewing) — deliberately separate from
  // canUploadDocuments so a future role could upload without full admin
  // rights, per the spec's "leave room for more granular policies" note.
  isAdmin                  Boolean  @default(false)
  // Default daily chat-message quota for every employee at this rank,
  // unless User.dailyMessageLimitOverride is set for them individually.
  // Deliberately never null/unlimited — see lib/usage/limits.ts's module
  // comment for why every level of this feature always carries a real
  // numeric ceiling, per an explicit request that there be no chance of
  // an unbounded AI bill from any single employee, department, or the
  // org as a whole. 300/day is the seeded default: generous enough that
  // real, heavy legitimate use essentially never hits it (this app's own
  // measured per-turn cost — condense + retrieval-embed + generate, on
  // the currently active Gemini flash-lite pricing — runs well under
  // $0.001/message), while still bounding one employee's worst-case
  // daily cost to a small, known number instead of nothing.
  defaultDailyMessageLimit Int      @default(300)
  createdAt                DateTime @default(now())

  users User[]

  @@index([hierarchyRank])
}

enum UserStatus {
  ACTIVE
  DISABLED
  // Soft-removed: login blocked (same check as DISABLED), hidden from the
  // main employee list, and only reachable via the dedicated "Removed
  // employees" admin page. An admin reviews the employee's uploaded
  // documents there (keeping or deleting each individually) before the
  // separate, real hard-delete action becomes available — see
  // deleteEmployeePermanentlyAction. Never set automatically; only via
  // removeEmployeeAction. No path back to ACTIVE is built — a removal is
  // meant to be a deliberate, one-way step toward hard-delete, not a
  // second flavor of disable.
  REMOVED
}

enum ThemePreference {
  LIGHT
  DARK
}

// Distinguishes how a User row came to exist — purely informational,
// nothing authorization-relevant reads this. Powers the "Added Via" column
// on the live roster export (see app/api/admin/employees/export) and lets
// the admin UI show provenance without joining through AuditLog, which has
// no reliable link from a bulk-created row back to the batch that created
// it (see EmployeeImportBatch's own comment).
enum CreationMethod {
  MANUAL
  BULK_IMPORT
}

model User {
  id                        String               @id @default(cuid())
  name                      String
  email                     String               @unique
  passwordHash              String
  roleId                    String
  role                      Role                 @relation(fields: [roleId], references: [id])
  // Zero, one, several, or every department — an implicit Prisma M2M (see
  // Department.users). Purely additive to the rank-based clearance system:
  // see DocumentChunk.departmentIds and lib/db/queries/chunks.ts for the
  // resulting "clearance OR department" visibility rule.
  departments               Department[]
  // Exactly ONE location, unlike departments above (zero-to-many) — every
  // employee works out of exactly one physical site, by explicit design
  // (see Location's own schema comment for the full visibility rule this
  // enforces). Required, not optional: there is no "no location" state for
  // an employee, so this is a plain required foreign key rather than an
  // implicit M2M — createEmployeeAction and bulkImportEmployeesAction both
  // require a value before a User row can be created at all.
  locationId                String
  location                  Location             @relation(fields: [locationId], references: [id])
  status                    UserStatus           @default(ACTIVE)
  // Account-level, not browser-level — follows the user across devices/
  // browsers, unlike a localStorage-only preference. Defaults to LIGHT.
  themePreference           ThemePreference      @default(LIGHT)
  // Provenance: who created this account (admin, self-relation), when
  // (createdAt, already below), and how (creationMethod). Set at
  // createEmployeeAction (MANUAL) and bulkImportEmployeesAction
  // (BULK_IMPORT) time and never changed afterward — this is what makes the
  // live roster export's "Added By / At / Via" columns queryable directly,
  // with no AuditLog join required.
  createdById               String?
  createdBy                 User?                @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers              User[]               @relation("CreatedBy")
  creationMethod            CreationMethod       @default(MANUAL)
  importBatchId             String?
  importBatch               EmployeeImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt                 DateTime             @default(now())
  lastLoginAt               DateTime?
  // Optional per-employee override of their role's own
  // defaultDailyMessageLimit — set by an admin for a specific employee
  // who genuinely needs a different (higher OR lower) daily chat-message
  // ceiling than their role's baseline. Null = inherit the role's
  // default; see Role.defaultDailyMessageLimit's own comment for why
  // there is no "unlimited" option anywhere in this feature.
  dailyMessageLimitOverride Int?

  accounts                     Account[]
  sessions                     Session[]
  loginSessions                LoginSession[]
  documents                    Document[]             @relation("UploadedBy")
  crawlSites                   CrawlSite[]            @relation("CrawlSiteUploadedBy")
  conversations                Conversation[]
  auditLogs                    AuditLog[]
  importedBatches              EmployeeImportBatch[]  @relation("ImportedBy")
  headOfDepartments            Department[]           @relation("DepartmentHead")
  aiProviderCredentialsUpdated AIProviderCredential[]
  orgUsagePoliciesUpdated      OrgUsagePolicy[]

  @@index([roleId])
  @@index([createdById])
  @@index([importBatchId])
  @@index([locationId])
}

// One row per uploaded employee CSV/XLSX, kept forever (never overwritten
// or deleted by a later upload) so a past sheet stays viewable/downloadable
// and every created employee can be traced back to the exact file and
// admin that created them. See bulkImportEmployeesAction, which is the only
// writer of this model.
model EmployeeImportBatch {
  id                 String   @id @default(cuid())
  // The original uploaded file, via getStorageProvider() — downloadable
  // again later, never edited in place.
  fileKey            String
  fileName           String
  uploadedById       String?
  uploadedBy         User?    @relation("ImportedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt         DateTime @default(now())
  rowCount           Int
  successCount       Int
  failureCount       Int
  // A generated XLSX of every row that failed validation (bad role, bad
  // department, or a genuine parse error) with a Reason column — null when
  // every row succeeded or was a harmless duplicate-email skip.
  errorReportFileKey String?

  createdUsers User[]

  @@index([uploadedById])
}

// Admin-managed org structure, purely additive to the rank-based clearance
// system above — see the module-level security note and
// DocumentChunk.departmentIds. A User can belong to any number of
// departments (including none, or all); a Document can be tagged with any
// number too.
//
// Deletable (see deleteDepartmentAction / lib/db/queries/departments.ts::
// deleteDepartment): the join-table rows on both sides cascade away via
// the FK constraints (a document simply loses this one tag, an employee
// simply loses this one membership — nothing else about either row is
// touched), and DocumentChunk.departmentIds is explicitly recomputed for
// every affected document in the same transaction, since that denormalized
// column isn't a foreign key and doesn't cascade on its own.
model Department {
  id                String   @id @default(cuid())
  name              String   @unique
  // Short blurb shown on the Departments admin page and the UKPCB
  // Directory — purely descriptive, never authorization-relevant.
  description       String?
  // A "head department" (the user's own term) sees every document tagged
  // with ANY department, not just its own — an umbrella of visibility over
  // every other department at once, layered on top of (never a
  // replacement for) the ordinary clearance-or-own-department rule. Does
  // NOT bypass clearance for a document with NO department at all — e.g. a
  // CXO-clearance document tagged with no department stays invisible to a
  // lower-clearance head-department member, exactly as it would to anyone
  // else; the umbrella only ever extends to documents some department
  // already reaches. See lib/auth/session.ts's hasHeadDepartmentAccess and
  // lib/db/queries/chunks.ts for the enforcement. Admin-togglable per
  // department (not hardcoded to one name), same "data, not code" spirit
  // as Role.isAdmin/canUploadDocuments.
  isHeadDepartment  Boolean  @default(false)
  // The department's designated lead — optional, and deliberately NOT a
  // capability or clearance boost of any kind (a head has exactly the
  // access their own Role and department memberships already grant, same
  // as any other member). Purely an org-chart label surfaced on both the
  // Departments admin page and the UKPCB Directory. SetNull if that
  // employee is later hard-deleted, mirroring every other "survives with
  // a cleared reference" pattern in this schema.
  headUserId        String?
  head              User?    @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: SetNull)
  // Aggregate daily chat-message budget across every member of this
  // department COMBINED — an OPTIONAL, stricter cost-center control
  // layered on top of (never a replacement for) each member's own
  // individual daily limit. Null (the default) means no department-level
  // cap at all: an admin opts a department into a tighter aggregate
  // budget deliberately, the same way a real company's finance/eng-ops
  // team assigns an explicit team budget only where the business actually
  // wants one, not as a blanket restriction applied to every department
  // automatically. A member belonging to several departments counts
  // against every one of them.
  dailyMessageLimit Int?
  createdAt         DateTime @default(now())

  users     User[]
  documents Document[]
}

// A separate, STRICTER visibility axis from Department above — physical
// site rather than org function. Two differences from Department drive
// every asymmetry between this model and that one:
//   1. Every employee has EXACTLY one location (User.locationId is a
//      required scalar FK, not an implicit M2M) — see that field's own
//      comment. A document, symmetrically with Department, can carry one
//      or more locations (Document.locations, an implicit M2M) since a
//      single notice can legitimately apply to several sites at once.
//   2. The visibility rule is a hard AND, not an OR: Department only ever
//      ADDS visibility on top of clearance (a document with no department
//      is visible on clearance alone). Location instead NARROWS it
//      unconditionally — a document is visible only to a viewer whose
//      single location appears among the document's location tags, no
//      exceptions, layered on top of (never instead of) the existing
//      clearance-and-department check. Every document is required to
//      carry at least one location (enforced in the upload/edit actions,
//      not the database, the same way clearance is already required
//      there) specifically so this check is never accidentally bypassable
//      by a document simply having none. See DocumentChunk.locationIds and
//      lib/db/queries/chunks.ts for the enforcement.
model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  documents Document[]
}

// A revocable record of one login, tracked entirely separately from Auth.js's
// own `Session` model above (which stays dead/unused — this app's auth is
// pure JWT, see auth.config.ts's own comment on why). Created once per
// successful sign-in from lib/auth/auth.config.ts's authorize() callback,
// which stashes this row's id into the JWT (token.sessionId) so
// getAuthContext() can check `revokedAt` on every request without needing a
// database session strategy. Lets a user see and revoke their own active
// logins from Settings — see lib/db/queries/loginSessions.ts.
model LoginSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// --- Documents & retrieval ------------------------------------------------

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Document {
  id                  String         @id @default(cuid())
  name                String
  description         String?
  fileKey             String
  mimeType            String
  fileSizeBytes       Int
  // Set only for a document added by pasting a URL (see
  // lib/documents/urlFetch.ts) rather than uploading a file — the fetched
  // page's own address, kept for traceability (shown in the Knowledge
  // Base table so an admin can tell at a glance this content came from
  // the web, not from someone's machine) and as the anchor for a future
  // "re-fetch" action. Null for every ordinary file upload.
  sourceUrl           String?
  // Storage key of a generated, clean PDF rendition — set only for a
  // non-PDF original (DOCX/PPTX/TXT/MD), null for a document that's
  // already a PDF (fileKey IS the viewable file there, nothing to
  // generate) and null until processing produces one. Exists so the
  // citation preview can always open an actual rendered page — pdf.js
  // only knows how to render PDFs — without touching fileKey/mimeType,
  // which stay the true original for downloads. Regenerated by
  // lib/documents/pipeline.ts on every (re)processing pass, including a
  // file replace, so it never drifts from the current content.
  previewFileKey      String?
  // True only for a document added through Admin → Public Content — a
  // deliberately separate pool from every clearance/department/location-
  // gated document above. A public document bypasses clearanceLevel,
  // departments, AND locations entirely (see the OR-bypass in
  // lib/db/queries/chunks.ts and lib/db/queries/documents.ts): it is
  // visible to the unauthenticated public chat (which can see NOTHING
  // else) and, simultaneously, to every logged-in employee regardless of
  // their own clearance/department/location — the one thing every visitor,
  // authenticated or not, is guaranteed to see. clearanceLevel is still
  // set (to 0, the lowest possible) for a public document purely because
  // the column is non-nullable; it plays no role in who can see it.
  // departments/locations are simply left empty. Denormalized onto
  // DocumentChunk.isPublic at write time, same as every other visibility
  // flag on this model.
  isPublic            Boolean        @default(false)
  // Semantically: the minimum Role.hierarchyRank required to view this
  // document. Stored as a plain int (not a Role relation) so it survives
  // even if roles are later restructured, and so it's cheap to compare.
  // Meaningless for a public document (isPublic above) — see its comment.
  clearanceLevel      Int
  // Zero, one, or several departments — an implicit Prisma M2M (see
  // Department.documents). Purely additive to clearanceLevel: a viewer sees
  // this document if their rank covers clearanceLevel OR they belong to any
  // department listed here. Denormalized onto DocumentChunk.departmentIds
  // at write time for the same reason clearanceRank already is — see this
  // file's module-level security note.
  departments         Department[]
  // One or more locations — required (see Location's own schema comment
  // for why this is a hard AND-narrowed visibility rule, unlike
  // departments above). Enforced at the application layer, in the same
  // upload/edit actions that already require clearanceLevel, since Prisma
  // can't express "at least one" on an implicit M2M directly.
  locations           Location[]
  tags                String[]       @default([])
  // Nullable so a hard-deleted employee (see deleteEmployeePermanentlyAction)
  // never forces their documents to be deleted along with them — the FK
  // just goes to null (onDelete: SetNull) and every "uploaded by" display
  // falls back to a fixed "Removed employee" label. Deleting the document
  // itself, if that's what's wanted, is always a separate, explicit choice
  // an admin makes on the removed-employee review page beforehand.
  uploadedById        String?
  uploadedBy          User?          @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  status              DocumentStatus @default(PENDING)
  processingError     String?
  // Set for every document while it's PROCESSING (both null only before
  // processing starts, or once it's READY/FAILED): total pages/segments in
  // the document, and how many have been embedded (and, for a scanned page
  // — see lib/documents/pipeline.ts's own comment — OCR'd first) so far.
  // Despite the name, this tracks BOTH of pipeline.ts's passes, not just
  // OCR — a non-scanned document's ordinary text-embedding pass counts
  // here too. A single processDocument() invocation can't always finish
  // embedding every page of a large document within Vercel's maxDuration,
  // so these two columns are what let a later invocation resume exactly
  // where an earlier one left off (see app/api/documents/[id]/status/
  // route.ts's idle-nudge, which is GATED on this being non-null — that's
  // the reason it's set unconditionally now, not just for scans: a
  // document pass 1 leaves mid-way with this still null would never get
  // resumed at all), and let the upload UI show real "page N of M"
  // progress instead of an indefinite "Processing…" for however long a
  // large document takes.
  ocrPagesTotal       Int?
  ocrPagesDone        Int?
  // A real hold-for-the-duration lock (not the same thing as updatedAt,
  // which changes on every unrelated write and so can't tell "a pass is
  // still actively running" apart from "nothing has happened in a
  // while") — set the moment a processDocument() pass claims this
  // document, cleared the moment that pass returns for any reason. Exists
  // because two pollers can legitimately trigger a resumed OCR pass close
  // together (see app/api/documents/[id]/status/route.ts's idle-nudge and
  // KnowledgeBase.tsx's own "nudge any visible PROCESSING document"
  // effect) — without a lock held for the pass's whole duration, both
  // invocations independently decide "page N isn't done yet" and both
  // OCR + insert chunks for it. Confirmed as a real, reproduced bug (a
  // single page ending up with ~4x its expected chunk count), not
  // theoretical — see lib/db/queries/documents.ts::claimDocumentForProcessing.
  // A lock older than LOCK_STALE_MS (that file) is treated as abandoned
  // (the holding invocation crashed or was killed) and can be reclaimed.
  processingClaimedAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  chunks DocumentChunk[]

  @@index([clearanceLevel])
  @@index([uploadedById])
}

// One row per (domain, isPublic) that a "crawl this site" URL-add has ever
// touched — the record "Process again" (lib/documents/siteCrawl.ts) reads
// to re-run the exact same crawl without the admin re-pasting the URL, and
// what the Websites view (WebsiteGroups.tsx, shared by the main Knowledge
// Base and Admin -> Public Content) reads to show each site's configured
// depth and when it was last crawled. `isPublic` mirrors Document.isPublic
// — the SAME domain can legitimately have two independent crawl configs,
// one per pool, since they're managed by entirely separate admin flows
// (see Document.isPublic's own comment). Deliberately NOT a record of
// every page ever discovered (no persisted frontier/queue) — a fresh
// crawl always restarts from rootUrl and walks the live link graph again;
// pages already ingested (found via the isPublic-scoped
// listIngestedSourceUrls) are simply never re-fetched or re-saved. This
// keeps "process any link that were not processed" self-healing across
// runs without needing its own separate queue table: a page discovered
// but not reached before a run's page cap ran out just gets rediscovered,
// the same way, on the next "Process again".
model CrawlSite {
  id           String   @id @default(cuid())
  domain       String
  // The exact URL originally pasted to start this site's crawl — always
  // re-fetched first on every "Process again" run, both to pick up
  // whatever's newly linked from it and (if it wasn't already ingested
  // for this pool) to ingest it again.
  rootUrl      String
  // How many link-hops to follow when discovering pages, same meaning as
  // addDocumentFromUrlAction's own crawlDepth — stored so "Process again"
  // reuses it without the admin re-entering it, and editable in place from
  // the Websites view without needing to re-paste the URL.
  depth        Int
  isPublic     Boolean  @default(false)
  uploadedById String?
  uploadedBy   User?    @relation("CrawlSiteUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  lastCrawledAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([domain, isPublic])
  @@index([isPublic])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String

  // pgvector column — dimensionality must match EMBEDDING_DIMENSIONS / the
  // active EmbeddingProvider. Prisma can't express the vector type directly,
  // so it's declared Unsupported and only ever touched via $queryRaw
  // (see lib/db/queries/chunks.ts and the pgvector migration SQL).
  embedding Unsupported("vector(768)")

  // Denormalized from Document.clearanceLevel at insert time — see the
  // module-level note above. This is the column every retrieval query
  // filters on.
  clearanceRank Int

  // Denormalized from Document.departments at insert/update time — same
  // reasoning as clearanceRank above, applied to the additive
  // department-visibility rule. Empty array for a document with no
  // departments (falls back to pure clearance). Checked via Postgres's
  // array-overlap operator (&&) against the viewer's own department ids —
  // see lib/db/queries/chunks.ts.
  departmentIds String[] @default([])

  // Denormalized from Document.locations at insert/update time — same
  // reasoning as departmentIds above, but checked as a hard AND rather
  // than an additive OR: see Location's own schema comment and
  // lib/db/queries/chunks.ts. Never legitimately empty (every document is
  // required to carry at least one location), but a chunk written before
  // this column existed defaults to empty, which the retrieval query
  // treats as "matches no location" rather than "unrestricted" —
  // deliberately the opposite fallback from departmentIds, since an empty
  // array here must never accidentally widen access.
  locationIds String[] @default([])

  // Denormalized from Document.isPublic — see that field's own comment.
  // Checked as an unconditional OR-bypass ahead of the clearance/
  // department/location conditions above: a public chunk is retrievable
  // regardless of what any of those three say, by every caller (the
  // unauthenticated public chat, and every logged-in employee alike).
  isPublic Boolean @default(false)

  // Which embedding provider/model actually produced this row's vector —
  // stamped at insert/re-embed time from the active EmbeddingProvider (see
  // that interface's own comment for the real incident this exists to
  // prevent). Null on any chunk indexed before this column existed —
  // deliberately NOT backfilled with a guess, since the whole point is to
  // distinguish "known to match the active provider" from "unknown/
  // possibly stale"; a null here is treated as stale by definition.
  // Compared against AIProviderCredential's active EMBEDDING row (never
  // trusted as a foreign key — a provider can be reconfigured, and old
  // chunks should still remember what actually embedded them) to detect
  // drift and drive the "re-embed" admin action.
  embeddingProvider AIProviderKind?
  embeddingModel    String?

  // 1-based PDF page number or PPTX slide number this chunk's text was
  // extracted from — null for DOCX/TXT/MD, which have no fixed pagination
  // in the source file itself (a DOCX's page breaks are a function of the
  // viewer/print layout, not stored data). Set once at insert time from
  // lib/documents/textExtraction.ts's per-page/per-slide segmentation —
  // never recomputed later, so it stays correct even if a future chunker
  // change alters chunk boundaries within a page. Powers the citation
  // preview's "open the source PDF to this exact page" feature.
  pageNumber Int?

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([clearanceRank])
}

// --- Conversations ---------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  // Cascade (not the default Restrict): when an employee is hard-deleted
  // (deleteEmployeePermanentlyAction), their conversations — and, via
  // Message's own cascade below, every message in them — are deleted along
  // with them. This is the one piece of a removed employee's data that is
  // NOT preserved, by explicit user decision; contrast with Document and
  // AuditLog, which both survive with the reference nulled out instead.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId])
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  // [{ documentId, documentName, chunkId }] — only ever populated from
  // chunks the asking user was already authorized to retrieve.
  citations      Json?
  // Thumbs up/down on an ASSISTANT message — nullable and toggleable
  // (clicking the active value again clears it back to null). Enforced
  // as assistant-only at the query layer (setMessageFeedbackAction),
  // not here — a USER message simply never gets this set. No index: it's
  // always read alongside a conversation's already-indexed messages,
  // never queried standalone.
  feedback       MessageFeedback?
  // Set only when a USER message has been edited (see updateMessageContent)
  // — null for every ASSISTANT message and every USER message that hasn't
  // been touched. Purely informational (renders a small "(edited)" marker);
  // nothing reads it to decide behavior.
  editedAt       DateTime?
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

enum MessageFeedback {
  UP
  DOWN
}

// --- AI provider configuration ------------------------------------------

enum AICapability {
  LLM
  EMBEDDING
}

enum AIProviderKind {
  ANTHROPIC
  GEMINI
  OPENAI
  OLLAMA
}

// Runtime-switchable LLM/embedding provider configuration, admin-managed
// from Admin → AI Models — see lib/llm/index.ts and
// lib/embeddings/index.ts, which read the (capability, isActive) row here
// FIRST and only fall back to the static env-var configuration in
// lib/config.ts if no row is active for that capability. This is what
// makes switching providers "plug and play": nothing here is required —
// an untouched deployment behaves exactly as it did before this model
// existed, entirely via env vars — but once an admin saves credentials and
// activates a provider, that takes over immediately, no redeploy needed.
//
// One row per (capability, provider) pair, not per active selection — a
// provider's credentials stay saved even while inactive, so switching back
// to a previously-configured provider doesn't require re-entering its key.
// `encryptedApiKey` is the only place a real secret lives in this schema —
// see lib/ai/crypto.ts for the AES-256-GCM scheme. It is NEVER selected by
// any query whose result can reach a client component; every UI-facing
// read exposes only `isConfigured: encryptedApiKey !== null`, never the
// value itself, encrypted or not — see lib/db/queries/aiProviders.ts.
model AIProviderCredential {
  id              String         @id @default(cuid())
  capability      AICapability
  provider        AIProviderKind
  encryptedApiKey String?
  // Ollama only — the base URL of the self-hosted server. Not a secret;
  // stored in plain text.
  baseUrl         String?
  // Optional override of the provider's default model name (see
  // lib/config.ts's own *_MODEL env vars for what "default" means per
  // provider). Null means "use the built-in default for this provider."
  model           String?
  isActive        Boolean        @default(false)
  updatedAt       DateTime       @updatedAt
  updatedById     String?
  updatedBy       User?          @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([capability, provider])
  @@index([capability, isActive])
}

// --- Usage limits --------------------------------------------------------
//
// Three levels of chat-message quota, all enforced together, all always
// carrying a real number (never "unlimited") — see lib/usage/limits.ts for
// the full mechanics and reasoning:
//   1. Per-employee (Role.defaultDailyMessageLimit, overridable per User)
//   2. Per-department, optional (Department.dailyMessageLimit)
//   3. Org-wide (OrgUsagePolicy, below) — the final circuit breaker,
//      independent of what any individual or department limit says.

// A genuine singleton: exactly one row, at a fixed known id, upserted by
// the admin action that edits it rather than created ad hoc — the fixed id
// (not a real cuid) is what makes "the org policy" unambiguous to query
// (findUnique by that id) without an isActive-style disambiguation flag,
// unlike AIProviderCredential above (which is deliberately multi-row per
// capability). This codebase had no prior singleton-config pattern to
// follow, so this establishes one rather than reusing AIProviderCredential's
// shape, which solves a different problem (many saved-but-inactive
// credentials) than this does (exactly one org-wide number).
model OrgUsagePolicy {
  id                String   @id @default("org-usage-policy")
  // The absolute ceiling on chat messages across every employee combined,
  // per UTC day — enforced even when no single employee or department is
  // anywhere near their own limit. 5000/day is the seeded default: at
  // this app's currently-configured Gemini flash-lite pricing (measured
  // this session at well under $0.001/message for a typical
  // retrieval-augmented turn), that bounds worst-case daily spend to a
  // few dollars regardless of how many employees exist or how the org
  // grows, while comfortably covering realistic total usage across the
  // whole company (roughly 89 employees today).
  dailyMessageLimit Int      @default(5000)
  // The public (unauthenticated) chat's own org-wide circuit breaker —
  // deliberately a SEPARATE pool from dailyMessageLimit above, which only
  // ever counts real employees: a spike of anonymous public traffic must
  // never be able to eat into (or be capped by) the company's own AI
  // budget, and vice versa. Checked together with a fixed per-visitor-IP
  // cap (see lib/usage/limits.ts::PUBLIC_IP_DAILY_LIMIT) — this is the
  // second, broader layer, the same two-tier shape (individual + org-wide)
  // employee usage already has. 200/day is a conservative seeded default
  // for a newly-exposed public surface; raise it from Admin → Usage Limits
  // once real traffic patterns are known.
  publicDailyMessageLimit Int @default(200)
  updatedAt         DateTime @updatedAt
  updatedById       String?
  updatedBy         User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

enum UsageScope {
  USER
  DEPARTMENT
  ORG
  // The public chat's org-wide counter (see OrgUsagePolicy.publicDailyMessageLimit) — scopeId is always the fixed string "public" (see PUBLIC_ORG_SCOPE_ID), the PUBLIC_ORG counterpart to ORG's "org".
  PUBLIC_ORG
  // One counter per distinct visitor IP address for the public chat — scopeId is the IP itself. Bounds a single source's worst-case daily cost independent of the org-wide PUBLIC_ORG breaker above.
  PUBLIC_IP
}

// One row per (scope, scopeId, day) — the atomic counter every quota check
// increments. A new UTC day means a new row (created on first use via the
// same atomic upsert that enforces the limit — see
// lib/usage/limits.ts::atomicCheckAndIncrement), so there is deliberately
// no reset job anywhere: yesterday's row is simply never touched again.
// scopeId is a User.id, Department.id, or the fixed string "org" for
// UsageScope.ORG — never a foreign key, since one column has to point at
// three different tables depending on `scope`; every real join happens in
// the query layer (lib/db/queries/usage.ts), not via a Prisma relation.
model UsageCounter {
  id      String     @id @default(cuid())
  scope   UsageScope
  scopeId String
  day     DateTime   @db.Date
  count   Int        @default(0)

  @@unique([scope, scopeId, day])
  @@index([scope, scopeId])
}

// --- Audit log ---------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  // LOGIN | LOGIN_FAILED | DOCUMENT_UPLOAD | DOCUMENT_PROCESSED |
  // CHAT_QUERY | ACCESS_DENIED
  action    String
  resource  String?
  result    String
  // e.g. { retrievedChunkIds, userClearanceRank } for CHAT_QUERY events
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([userId])
}
